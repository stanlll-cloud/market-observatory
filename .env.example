# Market Observatory (.env.example)
# No API keys are required to run charts, ChanLun structure, Quant Radar, or ETF Plan.
# Copy to `.env` only if you want automated Telegram / Webhook MA crossover notifications.

# --- Optional: Telegram Bot Auto-Push (MA Crossover Alerts) ----------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: Generic Webhook Push (Discord / Slack / Feishu / Bark) ------
WEBHOOK_URL=

# --- Optional: Background Scan Interval (seconds, default 180) -------------
MA_ALERT_POLL_SEC=180

# --- Optional: Outbound HTTP Proxy (useful in restricted networks) ---------
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
